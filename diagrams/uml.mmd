classDiagram
    class Owner {
        -String name
        -List~Pet~ pets
        +addPet(pet: Pet) void
        +getPets() List~Pet~
        +getAllTasks() List~Task~
    }

    class Pet {
        -String name
        -String species
        -List~String~ preferences
        -List~Task~ tasks
        +addTask(task: Task) void
        +getTasks() List~Task~
    }

    class Task {
        -String description
        -int durationMinutes
        -String priority
        -String frequency
        -String petName
        -boolean completed
        +setPriority(priority: String) void
        +markComplete() void
    }

    class Scheduler {
        -List~Task~ taskQueue
        -Dict constraints
        +buildSchedule(owner: Owner, constraints: Dict) List~Task~
        +explainPlan() String
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler ..> Owner : reads
    Scheduler ..> Task : schedules
