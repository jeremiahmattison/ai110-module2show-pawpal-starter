classDiagram
    class Owner {
        -String name
        -List~Pet~ pets
        +addPet(pet: Pet) void
        +getPets() List~Pet~
    }

    class Pet {
        -String name
        -String species
        -List~String~ preferences
        -List~Task~ tasks
        +addTask(task: Task) void
        +getTasks() List~Task~
    }

    class Task {
        -String title
        -int durationMinutes
        -String priority
        -boolean completed
        +setPriority(priority: String) void
        +markComplete() void
    }

    class Scheduler {
        -List~Task~ taskQueue
        -Dict constraints
        +buildSchedule(tasks: List~Task~, constraints: Dict) List~Task~
        +explainPlan() String
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler ..> Pet : reads
    Scheduler ..> Task : schedules
